# Pixel 4 (flame) - ReSukiSU + SUSFS Stealth Kernel
# Android 11, Kernel 4.14

CONFIG_ENV=config/pixel4.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/msm
KERNEL_SOURCE_BRANCH=android-msm-coral-4.14-android11
KERNEL_CONFIG=floral_defconfig
KERNEL_IMAGE_NAME=Image.lz4-dtb
ARCH=arm64

KERNEL_NAME=RolexStealth
ADD_LOCALVERSION_TO_FILENAME=false

# Extra make flags for kernel 4.14
# DTC_FLAGS_MODULE disables parser warnings that break with newer dtc
EXTRA_CMDS=LD=ld.lld KCFLAGS=-Wno-error DTC_FLAGS=-@
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Use older Android Clang that is less strict
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
# USE_LLVM=false means use GCC assembler/linker, not LLVM
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
# Standard KernelSU v0.9.5 + SUSFS (simonpunk patches match this layout)
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5
KSU_HOOK_MODE=manual

# Custom manager signature (leave blank for official)
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# ENABLED with kernel 4.14 fixes (inotify_mark_user_mask + may_mount)
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

# ========================================================== Extra patches ===
# path_umount needed for KernelSU on kernel < 5.9
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# Extra defconfig options for stealth
# Disable DTBO build that fails with newer dtc
EXTRA_DEFCONFIG=CONFIG_LOCALVERSION="" CONFIG_LOCALVERSION_AUTO=n CONFIG_IKCONFIG=n CONFIG_IKCONFIG_PROC=n CONFIG_DEBUG_INFO=n CONFIG_FTRACE=n CONFIG_CC_STACKPROTECTOR_STRONG=n CONFIG_STACKPROTECTOR=n CONFIG_STACKPROTECTOR_STRONG=n CONFIG_BUILD_ARM64_DT_OVERLAY=n

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
