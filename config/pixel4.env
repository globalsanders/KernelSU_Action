# Pixel 4 (flame) - ReSukiSU + SUSFS Stealth Kernel
# Android 11, Kernel 4.14

CONFIG_ENV=config/pixel4.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/msm
KERNEL_SOURCE_BRANCH=android-msm-coral-4.14-android11
KERNEL_CONFIG=floral_defconfig
KERNEL_IMAGE_NAME=Image.lz4-dtb
ARCH=arm64

KERNEL_NAME=RolexStealth
ADD_LOCALVERSION_TO_FILENAME=false

# Extra make flags for kernel 4.14
# Explicitly set cross-compiler AS to avoid /usr/bin/as being used
EXTRA_CMDS=LD=ld.lld KCFLAGS=-Wno-error
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu- AS=\${CROSS_COMPILE}as

# =================================================================== Clang ==
# Use newer Android Clang that works with Ubuntu 22.04
CLANG_BRANCH=main
CLANG_VERSION=r536225

USE_CUSTOM_CLANG=false
# LLVM=0 forces use of GCC binutils (as, ld) instead of LLVM tools
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
# SukiSU-Ultra builtin bundelt SUSFS zelf - geen externe patches nodig
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=auto

# Custom manager signature (leave blank for official)
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# SukiSU-Ultra builtin heeft SUSFS al ingebouwd - externe patches niet nodig
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# path_umount needed for kernel < 5.9
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# Extra defconfig options for stealth
EXTRA_DEFCONFIG=CONFIG_LOCALVERSION="" CONFIG_LOCALVERSION_AUTO=n CONFIG_IKCONFIG=n CONFIG_IKCONFIG_PROC=n CONFIG_DEBUG_INFO=n CONFIG_FTRACE=n CONFIG_CC_STACKPROTECTOR_STRONG=n CONFIG_STACKPROTECTOR=n CONFIG_STACKPROTECTOR_STRONG=n

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
